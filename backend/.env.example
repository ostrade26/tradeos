# Railway injects this when you attach Postgres and set:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Leave empty locally to keep using SQLite at backend/data/trade.db
DATABASE_URL=

# Comma-separated extra browser origins (optional).
# *.vercel.app and https://www.tradeal.in / https://tradeal.in are already allowed in code.
CORS_ORIGINS=

# Optional admin token for /api/v1/admin/* if the session is not an admin.
# Also used by CI/deploy to POST /api/v1/platform/releases/from-deploy (header: x-tradeal-token).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the SAME value in:
#   1) Railway API service → Variables → TRADEAL_API_TOKEN
#   2) GitHub repo → Settings → Secrets → TRADEAL_API_TOKEN
# Plus GitHub secret TRADEAL_API_URL = https://your-api.up.railway.app (no /api/v1 suffix).
# Then each push to main registers a draft release and notifies Tradeal admins (inbox).
TRADEAL_API_TOKEN=

# Seeded only when the users table is empty (first deploy after RBAC migration).
# Format: user:password:role[:display name],...  Roles: admin | operator
# (admin → Organisation Admin, operator → Operator)
# TRADEAL_USERS=admin:change-me:admin:Admin,ops:change-me:operator:Ops

# Seeded only when the users table is empty. Never overwrites an existing platform admin.
# TRADEAL_PLATFORM_ADMIN=username:password:Display Name

# Initial password for new organisation primary admins (username = their email). Override in production.
# TRADEAL_DEFAULT_USER_PASSWORD=Welcome2Tradeal!
