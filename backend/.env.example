# Railway injects this when you attach Postgres and set:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Leave empty locally to keep using SQLite at backend/data/trade.db
DATABASE_URL=

# Comma-separated browser origins allowed to call the API (custom Vercel domain).
# *.vercel.app preview/production hosts are already allowed in code.
CORS_ORIGINS=https://your-app.vercel.app

# Optional admin token for /api/v1/admin/* if the session is not an admin.
TRADEAL_API_TOKEN=

# Seeded only when the users table is empty (first deploy after RBAC migration).
# Format: user:password:role[:display name],...  Roles: admin | operator
# (admin → Organisation Admin, operator → Operator)
# TRADEAL_USERS=admin:change-me:admin:Admin,ops:change-me:operator:Ops

# Tradeal platform admin (creates orgs/users via /api/v1/platform/*). Seeded once if users table empty.
# TRADEAL_PLATFORM_ADMIN=platform:change-me:Tradeal Admin

# Initial password for new organisation primary admins (username = their email). Override in production.
# TRADEAL_DEFAULT_USER_PASSWORD=Welcome2Tradeal!
